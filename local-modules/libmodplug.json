{
  "name": "libmodplug",
  "rm-configure": true,
  "buildsystem": "autotools",
  "builddir": true,
  "config-opts": [
    "--enable-shared",
    "--disable-static",
    "--enable-silent-rules"
  ],
  "sources": [
    {
      "url": "https://downloads.sourceforge.net/sourceforge/modplug-xmms/libmodplug/0.8.9.2/libmodplug-0.8.9.2.tar.gz",
      "sha256": "e4d9cb46da78a639d6eadb4ff3ab955f68c3099579b5310af64b37091e28957e",
      "x-checker-data": {
        "type": "anitya",
        "project-id": 5669,
        "stable-only": true,
        "url-template": "https://downloads.sourceforge.net/sourceforge/modplug-xmms/libmodplug/$version/libmodplug-$version.tar.gz"
      },
      "type": "archive"
    },
    {
      "commands": [
        "autoreconf -fiv"
      ],
      "dest-filename": "autogen.sh",
      "type": "script"
    }
  ],
  "cleanup": [
    "/lib/pkgconfig",
    "/lib/libmodplug.so",
    "/lib/libmodplug.la",
    "/include/libmodplug"
  ]
}
